  "moves": {
    "mark_sent": {"set": {"app": "sent", "sent_by": "$by"}, "setdefault": {"sent_at": "$sent_at"},
                  "clear": ["rm", "approve"], "lock_form": true},
    "sent_elsewhere": {"history": ["apply", "approve"], "do": ["mark_sent"]},
    "unsend": {"clear": ["sent_at", "sent_v", "sent_by", "sent_rec", "oc", "oc_at", "oc_auto", "replies", "ev", "ghost_no", "approve"],
               "unlock_form": true},
    "refill": {"clear": ["apply.session", "apply.stale", "apply.submit_fail", "apply.tab_id", "apply.chrome", "approve"],
               "merge": {"apply": "$apply"}, "to": "running"},
    "run_done": {"set": {"apply": "$apply"}, "keep": ["apply.stale"]}
  },
  "cells": {
    "todo": {
      "fill_start": {"do": ["refill"]},
      "answers_changed": {"to": "todo"},
      "files_changed": {"to": "todo"},
      "page_lost": {"to": "todo"},
      "leave": {"to": "todo"},
      "sent_manual": {"do": ["sent_elsewhere"], "to": "sent"},
      "platform_found": {"do": ["sent_elsewhere"], "set": {"sent_at": "$sent_at", "sent_rec": "$rec"}, "to": "sent"}
    },
    "running": {
      "tab_handed": {"merge": {"apply": "$apply"}, "to": "running"},
      "form_recorded": {"to": "running"},
      "fill_ok": {"do": ["run_done"], "to": "parked", "when": [{"if": "apply.stale", "to": "stale"}]},
      "fill_bad": {"do": ["run_done"], "to": "stuck", "when": [{"if": "apply.stale", "to": "stale"}]},
      "fill_nopage": {"set": {"apply": "$apply"}, "to": "nopage"},
      "fill_submitted": {"set": {"apply.sent": "$evidence", "ev": "$ev", "apply.tab_id": ""}, "do": ["mark_sent"], "to": "sent"},
      "answers_changed": {"to": "running"},
      "files_changed": {"set": {"apply.stale": "$why"}, "to": "running"},
      "page_lost": {"to": "running"},
      "platform_found": {"do": ["sent_elsewhere"], "set": {"sent_at": "$sent_at", "sent_rec": "$rec"}, "to": "sent"}
    },
    "nopage": {
      "fill_start": {"do": ["refill"]},
      "answers_changed": {"to": "nopage"},
      "files_changed": {"to": "nopage"},
      "page_lost": {"to": "nopage"},
      "leave": {"to": "nopage"},
      "sent_manual": {"do": ["sent_elsewhere"], "to": "sent"},
      "platform_found": {"do": ["sent_elsewhere"], "set": {"sent_at": "$sent_at", "sent_rec": "$rec"}, "to": "sent"}
    },
    "parked": {
      "fix_start": {"merge": {"apply": "$apply"}, "to": "running"},
      "confirm": {"set": {"approve": "$approve"}, "to": "confirmed"},
      "check_failed": {"clear": ["apply.attachment_cache"], "merge": {"apply": "$apply"}, "to": "stuck"},
      "answers_changed": {"to": "parked"},
      "files_changed": {"set": {"apply.stale": "$why"}, "to": "stale"},
      "page_lost": {"set": {"apply.tab_id": "", "apply.issues": "$issues"}, "to": "gone"},
      "leave": {"to": "parked"},
      "sent_manual": {"do": ["sent_elsewhere"], "to": "sent"},
      "platform_found": {"do": ["sent_elsewhere"], "set": {"sent_at": "$sent_at", "sent_rec": "$rec"}, "to": "sent"}
    },
    "stuck": {
      "fill_start": {"do": ["refill"]},
      "fix_start": {"merge": {"apply": "$apply"}, "to": "running"},
      "check_failed": {"clear": ["apply.attachment_cache"], "merge": {"apply": "$apply"}, "to": "stuck"},
      "answers_changed": {"to": "stuck"},
      "files_changed": {"set": {"apply.stale": "$why"}, "to": "stale"},
      "page_lost": {"set": {"apply.tab_id": "", "apply.issues": "$issues"}, "to": "gone"},
      "leave": {"to": "stuck"},
      "sent_manual": {"do": ["sent_elsewhere"], "to": "sent"},
      "platform_found": {"do": ["sent_elsewhere"], "set": {"sent_at": "$sent_at", "sent_rec": "$rec"}, "to": "sent"}
    },
    "stale": {
      "fill_start": {"do": ["refill"]},
      "answers_changed": {"to": "stale"},
      "files_changed": {"set": {"apply.stale": "$why"}, "to": "stale"},
      "page_lost": {"set": {"apply.tab_id": "", "apply.issues": "$issues"}, "clear": ["apply.stale"], "to": "gone"},
      "leave": {"to": "stale"},
      "sent_manual": {"do": ["sent_elsewhere"], "to": "sent"},
      "platform_found": {"do": ["sent_elsewhere"], "set": {"sent_at": "$sent_at", "sent_rec": "$rec"}, "to": "sent"}
    },
    "gone": {
      "fill_start": {"do": ["refill"]},
      "answers_changed": {"to": "gone"},
      "files_changed": {"to": "gone"},
      "page_lost": {"to": "gone"},
      "leave": {"to": "gone"},
      "sent_manual": {"do": ["sent_elsewhere"], "to": "sent"},
      "platform_found": {"do": ["sent_elsewhere"], "set": {"sent_at": "$sent_at", "sent_rec": "$rec"}, "to": "sent"}
    },
    "confirmed": {
      "submit_start": {"to": "sending"},
      "unconfirm": {"clear": ["approve"], "to": "parked"},
      "answers_changed": {"clear": ["approve"], "to": "parked"},
      "check_failed": {"clear": ["approve", "apply.attachment_cache"], "merge": {"apply": "$apply"}, "to": "stuck"},
      "files_changed": {"clear": ["approve"], "set": {"apply.stale": "$why"}, "to": "stale"},
      "page_lost": {"clear": ["approve"], "set": {"apply.tab_id": "", "apply.issues": "$issues"}, "to": "gone"},
      "leave": {"clear": ["approve"], "to": "parked"},
      "sent_manual": {"do": ["sent_elsewhere"], "to": "sent"},
      "platform_found": {"do": ["sent_elsewhere"], "set": {"sent_at": "$sent_at", "sent_rec": "$rec"}, "to": "sent"}
    },
    "sending": {
      "submit_ok": {"set": {"apply.sent": "$evidence", "ev": "$ev", "apply.tab_id": ""}, "clear": ["apply.submit_fail"], "do": ["mark_sent"], "to": "sent"},
      "submit_unsure": {"set": {"apply.submit_fail": "$evidence"}, "to": "unsure"},
      "submit_not_started": {"to": "confirmed"},
      "submit_not_sent": {"clear": ["approve", "apply.attachment_cache"], "merge": {"apply": "$apply"}, "to": "stuck"},
      "answers_changed": {"to": "sending"},
      "page_lost": {"to": "sending"},
      "platform_found": {"do": ["sent_elsewhere"], "set": {"sent_at": "$sent_at", "sent_rec": "$rec"}, "to": "sent"}
    },
    "unsure": {
      "not_sent": {"history": ["apply.submit_fail"], "clear": ["approve"], "to": "parked",
                   "when": [{"unless": "apply.tab_id", "clear": ["apply.stale"], "set": {"apply.issues": "$issues"}, "to": "gone"},
                            {"if": "apply.stale", "to": "stale"}]},
      "actually_sent": {"set": {"apply.sent": "$evidence", "apply.tab_id": ""}, "clear": ["apply.submit_fail"], "do": ["mark_sent"], "to": "sent"},
      "answers_changed": {"to": "unsure"},
      "files_changed": {"set": {"apply.stale": "$why"}, "to": "unsure"},
      "page_lost": {"set": {"apply.tab_id": ""}, "to": "unsure"},
      "sent_manual": {"do": ["sent_elsewhere"], "to": "sent"},
      "platform_found": {"do": ["sent_elsewhere"], "set": {"sent_at": "$sent_at", "sent_rec": "$rec"}, "to": "sent"}
    },
    "sent": {
      "undo_sent": {"guard": {"sent_by": ["agent"]}, "history": ["apply", "approve", "sent_at", "sent_v", "sent_by", "sent_rec", "ev", "oc", "oc_at", "oc_auto", "replies", "ghost_no"],
                    "do": ["unsend"], "set": {"app": "ship"}, "to": "todo"},
      "back": {"guard": {"sent_by": ["manual", "platform", "legacy"]}, "history": ["apply"], "push": {"sync_no": "sent_rec"},
               "do": ["unsend"], "set": {"app": "$to"}, "to": "todo"},
      "retry": {"tries": ["sent_at", "sent_v", "oc", "oc_at", "oc_auto", "replies", "form", "apply", "approve", "ev", "ghost_no"],
                "clear": ["sent_by", "sent_rec"], "set": {"app": "ship"}, "to": "todo"},
      "platform_found": {"set": {"sent_at": "$sent_at", "sent_rec": "$rec"}, "clear": ["rm"], "to": "sent"},
      "answers_changed": {"to": "sent"},
      "files_changed": {"to": "sent"},
      "page_lost": {"to": "sent"},
      "leave": {"to": "sent"}
    }
